{
  "name": "kanban-musume",
  "version": "0.1.0",
  "description": "Anime mascots (看板娘) for coding: a desktop pet and a VS Code companion that act out what you and your coding agent are doing.",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "demo": "npm run build && electron . --demo",
    "smoke": "npm run build && electron . --smoke",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pets:draw": "python scripts/pets/draw_twins_hd.py --preview && python scripts/pets/draw_twins.py --preview",
    "pets:install-codex": "node scripts/install-codex-pets.mjs",
    "vscode:build": "node vscode/build.mjs",
    "vscode:test": "npm run vscode:build && node scripts/test-vscode.mjs",
    "vscode:package": "npm run vscode:build && node vscode/package.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "acpx": "0.19.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.0",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
